<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- progress.tsv lives in filesDir; include it so a device-to-device transfer
         carries the learner's progress. Settings are in SharedPreferences. -->
    <include domain="file" path="." />
    <include domain="sharedpref" path="." />
    <exclude domain="file" path="export" />
</full-backup-content>
